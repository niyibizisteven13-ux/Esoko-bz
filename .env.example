# APP_URL is optional. When empty, public email links are inferred from the
# current serving domain/proxy host, which works for Cloudflare tunnels and Render.
# Set it only when you want one canonical production domain.
APP_URL=
NODE_ENV=development
PORT=5173
TRUST_PROXY=1

# Firebase
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Email Service (SMTP/Gmail/Brevo/Mailgun/SendGrid/Zoho)
EMAIL_PROVIDER=smtp
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_FROM=Esoko App <your-email@gmail.com>
SMTP_PORT=587
SMTP_FALLBACK_PORTS=2525,465
SMTP_SECURE=false
SMTP_FAMILY=4
SMTP_FORCE_IPV4=true
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=60000
SMTP_GREETING_TIMEOUT_MS=60000
SMTP_SOCKET_TIMEOUT_MS=120000
# Keep true for normal SMTP accounts. Set false only when using a trusted relay
# that does not require username/password authentication.
SMTP_REQUIRE_AUTH=true

# Optional aliases also accepted by the server:
# SMTP_USERNAME, SMTP_PASSWORD, MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS, MAIL_FROM

# Optional HTTPS email provider. Use EMAIL_PROVIDER=resend only after verifying
# your sending domain in Resend. Use EMAIL_PROVIDER=auto to allow fallback.
RESEND_API_KEY=
RESEND_FROM=Esoko App <onboarding@resend.dev>

# JWT secret used to sign authentication tokens
JWT_SECRET=replace-with-a-secure-random-secret

# Local development only. Used if JWT_SECRET is intentionally unset outside production.
DEV_JWT_SECRET=replace-with-a-local-development-secret

# Comma-separated list of allowed production frontend origins for CORS.
# Same-origin, *.onrender.com, and *.trycloudflare.com are accepted dynamically.
# Example for custom domains: https://app.example.com,https://admin.example.com
FRONTEND_URLS=
# Temporary tunnel/preview origins are disabled in production by default.
# Set true only for a controlled trycloudflare/onrender preview deployment.
ALLOW_DYNAMIC_PUBLIC_ORIGINS=false

# Cookie behavior. Use strict for same-origin deployments. Use none only with HTTPS
# when frontend and backend are on different sites.
COOKIE_SAMESITE=strict

# Upload limit in MB. Keep this small unless using dedicated object storage.
UPLOAD_MAX_MB=50
DATA_DIR=data
UPLOAD_DIR=uploads

# Number opened by the profile WhatsApp verification handoff.
VITE_SUPPORT_WHATSAPP=+250795806631
WHATSAPP_OTP_SENDER=+250795806631

# Optional WhatsApp Business/API bridge for automatic OTP delivery.
# The app POSTs { from, to, message, otp, userId, template } to this URL.
WHATSAPP_OTP_PROVIDER_URL=
WHATSAPP_OTP_PROVIDER_TOKEN=

# HTTPS configuration (optional)
SSL_KEY_PATH=/path/to/ssl.key
SSL_CERT_PATH=/path/to/ssl.crt

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=
