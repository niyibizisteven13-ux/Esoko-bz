# APP_URL is optional. When empty, public email links are inferred from the
# current serving domain/proxy host, which works for Cloudflare tunnels and Render.
# Set it only when you want one canonical production domain.
APP_URL=
NODE_ENV=development
PORT=5173
TRUST_PROXY=1

# Firebase
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Email Service (SMTP/Gmail)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_FROM=Esoko App <your-email@gmail.com>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FAMILY=4

# JWT secret used to sign authentication tokens
JWT_SECRET=replace-with-a-secure-random-secret

# Local development only. Used if JWT_SECRET is intentionally unset outside production.
DEV_JWT_SECRET=replace-with-a-local-development-secret

# Comma-separated list of allowed production frontend origins for CORS.
# Same-origin, *.onrender.com, and *.trycloudflare.com are accepted dynamically.
# Example for custom domains: https://app.example.com,https://admin.example.com
FRONTEND_URLS=

# Cookie behavior. Use strict for same-origin deployments. Use none only with HTTPS
# when frontend and backend are on different sites.
COOKIE_SAMESITE=strict

# Upload limit in MB. Keep this small unless using dedicated object storage.
UPLOAD_MAX_MB=50
UPLOAD_DIR=uploads

# HTTPS configuration (optional)
SSL_KEY_PATH=/path/to/ssl.key
SSL_CERT_PATH=/path/to/ssl.crt

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=
